; Padreen 配置（可选）。复制为 padreen.ini 后修改；不存在时使用默认值。主界面里的设置会写回这个文件。
[padreen]
; adb.exe 路径；留空 = 先找本目录下的 adb\adb.exe（没有就不启用 USB，只走 Wi-Fi）
adb=
; 平板 App 安装包；留空 = 本目录下的 padreen.apk
apk=
; 只接受这个型号的 USB(adb) 设备（HMW-W09 = 华为 MatePad Paper）；留空 = 任何 adb 设备
model=HMW-W09
; 1 = 极速模式（纯黑白，约 0.1 秒一次）；0 = 画质模式（4 级灰度，约 0.6 秒一次）
fast_bw=1
; 极速模式的刷新方式：du（稳妥）/ a2f6（默认，更跟手）/ a2f7 / a2f8 / a2f9 / a2。主界面里也能切
fast_wave=a2f6
; 自动补灰阶（会对屏幕的局部做灰阶刷新）：off（默认，不自动局部刷新，灰阶只在整屏刷新时出现）/ light（停手 3 秒后补 2 小块）/ full（停手后逐块补满）
settle=off
; full 档的起始等待（毫秒）
settle_ms=1200
; 1 = 在平板上画鼠标指针
cursor=1
; 每隔多少分钟整屏刷新一次（0 = 不自动，手动三指轻点或用主界面按钮）
full_refresh_minutes=0
; 1 = 大量绘制后平静一会儿就整屏刷新一次清残影（会整屏黑白闪一下），默认关
auto_clean=0
; 1 = 允许程序自己做整屏灰阶刷新（整页重绘平静后、重新同步后）；0（默认）= 只在你要求时整屏刷新
auto_full=0
; 1 = 连接时把"平板这块虚拟屏"的壁纸换成纯白（退出时还原；只改这一块屏的壁纸，电脑自己的屏幕和壁纸不动，程序还会盯着：万一哪块真实屏幕出现了这张白图会立刻改回去）
plain_wallpaper=1
; 电脑到平板的 TCP 端口（经 adb forward，USB 用）
port=38700
; 虚拟屏刷新率
mode_hz=60
; 局域网（Wi-Fi）：1 = 允许已配对的平板通过局域网连接（电脑监听 TCP lan_port / UDP lan_discovery_port，需要防火墙规则）
lan=1
lan_port=38702
lan_discovery_port=38703
; 配对窗口（配对码）的有效分钟数
pair_minutes=5
; Wi-Fi 连接中断（网络抖动、平板 App 被重启）时，电脑保留虚拟屏等待同一块平板重连的秒数（0 = 不等，立即撤掉虚拟屏）
lan_grace_seconds=45
; 1 = 连接平板期间合上笔记本盖子也不休眠（需要安装包里的「电源助手」服务；断开后自动还原）
lid_keep_awake=1
; 0 = 忽略 USB 线，只走局域网（测试/偏好）
usb=1
; 触控输入：1 = 在平板上用手指点按/拖动会作用到电脑（Windows 触控注入，支持多指）
touch=1
; touch = 真触控（默认）；mouse = 用鼠标模拟（只认第一根手指，作为备用）
touch_mode=touch
; 平板上的三指上滑 / 下滑手势变成键盘快捷键：上滑 = Win+Tab（多桌面），下滑 = 窗口切换。1 = 开，0 = 关（三指轻点整屏刷新在平板本地处理，不受这个开关影响）
gestures=1
; 三指下滑的窗口切换方式：switcher = Ctrl+Alt+Tab（切换器停在屏幕上，用手指点选窗口）；alttab = 普通 Alt+Tab（直接切到上一个窗口）
gesture_down=switcher
; 自动旋转：平板转到竖屏时，电脑上这块虚拟屏也变成竖屏（1404×1872），转回横屏再变回来（1872×1404）：1 = 开（默认），0 = 关（关了以后平板会自动留在横屏）。主界面和托盘菜单里的「自动旋转」开关就是它，连接着也能随时切换。需要驱动里登记过竖屏模式（安装包会登记）
rotate=1
; 以下由程序自动写入：firewall_asked（已问过防火墙）、welcomed（已显示过首次配对窗口）
