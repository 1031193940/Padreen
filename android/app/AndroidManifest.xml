<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.padreen.app"
    android:versionCode="17"
    android:versionName="1.1.3">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="29" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- lets the home screen open the system's uninstall dialog for the former product's app (Intent.ACTION_DELETE needs it since Android 9) -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <application
        android:label="Padreen"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- the home screen: find PCs on the LAN, pair with a code, connect -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- the e-ink display: started by the home screen (LAN session) or by Padreen over adb (USB) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density" />
        <!-- keeps the process alive (foreground) while a display session exists, so switching to another app does not drop the connection -->
        <service
            android:name=".SessionService"
            android:exported="false" />
    </application>
</manifest>